{
    admin off
    auto_https off
    persist_config off
    servers {
        trusted_proxies static private_ranges
    }
}

:80 {
    root * /srv
    encode gzip zstd

    # App Store redirect — embedded in shared images
    redir /get https://apps.apple.com/app/id6767120480 302

    # Friendly aliases without .html
    redir /privacy /privacy.html 301
    redir /terms   /terms.html   301

    # Health check
    respond /healthz "ok" 200

    # Long cache for static assets
    @assets path *.css *.js *.svg *.ico *.png *.jpg *.jpeg *.webp *.woff *.woff2
    header @assets Cache-Control "public, max-age=604800, immutable"

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
    }

    file_server
}
